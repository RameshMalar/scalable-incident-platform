      "description": "Original deployed Workbook query. Fixed last 7 days; percentiles are of metric Maximum samples, not individual requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "/subscriptions/a3bb9202-635d-4ab5-aaa4-5458f296b64e/resourceGroups/rg-incident-platform/providers/Microsoft.OperationalInsights/workspaces/incident-logs"
            ],
            "workspace": "c424063b-39b1-4ffc-bdf6-1d8e9b55c932",
            "resultFormat": "table",
            "query": "AzureMetrics\n| where TimeGenerated > ago(7d)\n| where ResourceGroup =~ 'rg-incident-platform'\n| where ResourceProvider == \"MICROSOFT.DOCUMENTDB\"\n| where MetricName == \"ServerSideLatency\"\n| summarize AvgLatency = avg(Average), P95Latency = percentile(Maximum, 95), MaxLatency = max(Maximum) by Resource\n| project Resource, AvgLatency = round(AvgLatency, 2), P95Latency = round(P95Latency, 2), MaxLatency = round(MaxLatency, 2)"
          }
        }
      ],
      "timeFrom": "7d"
    },

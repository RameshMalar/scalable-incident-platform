      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Monitor",
          "azureMonitor": {
            "resourceUri": "/subscriptions/a3bb9202-635d-4ab5-aaa4-5458f296b64e/resourceGroups/rg-incident-platform/providers/Microsoft.ServiceBus/namespaces/incident-bus-4pqaac2c4e4hs",
            "metricNamespace": "Microsoft.ServiceBus/namespaces",
            "metricName": "IncomingMessages",
            "aggregation": "Total",
            "timeGrain": "auto",
            "dimensionFilters": [
              {
                "dimension": "EntityName",
                "operator": "eq",
                "filters": [
                  "incident-events"
                ]
              }
            ],
            "alias": "incident-events"
          }
        },
        {
          "refId": "B",
          "queryType": "Azure Monitor",
          "azureMonitor": {
            "resourceUri": "/subscriptions/a3bb9202-635d-4ab5-aaa4-5458f296b64e/resourceGroups/rg-incident-platform/providers/Microsoft.ServiceBus/namespaces/incident-bus-4pqaac2c4e4hs",
            "metricNamespace": "Microsoft.ServiceBus/namespaces",
            "metricName": "IncomingMessages",
            "aggregation": "Total",
            "timeGrain": "auto",
            "dimensionFilters": [
              {
                "dimension": "EntityName",
                "operator": "eq",
                "filters": [
                  "notification-events"
                ]
              }
            ],
            "alias": "notification-events"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "sum",
              "count"
            ]
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Count",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Count": true
            },
            "renameByName": {
              "Field": "Queue",
              "Total": "Messages"
            }
          }
        }
      ],
      "description": "Observed message counts for each queue over the selected range: Azure Total per bucket, then Grafana sum of returned buckets. Not a lifetime total, a rate, unique incidents, or a combined pipeline total. Missing buckets make this a partial subtotal. All-null/empty series are excluded using Count > 0; real zeros remain zero. Azure telemetry may lag several minutes.",
      "options": {
        "reduceOptions": {
          "values": true,
          "fields": "/^Messages$/",
          "calcs": []
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },

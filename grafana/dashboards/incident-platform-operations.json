    {
      "id": 5,
      "title": "Container Apps | System Events by App and Severity",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 7
      },
      "description": "Existing ContainerAppSystemLogs_CL only. Counts log records, not failures, replicas, readiness or uptime. No events is not proof of health. A query error requires checking MSI workspace access; raw log messages are intentionally excluded.",
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "/subscriptions/a3bb9202-635d-4ab5-aaa4-5458f296b64e/resourceGroups/rg-incident-platform/providers/Microsoft.OperationalInsights/workspaces/incident-logs"
            ],
            "workspace": "c424063b-39b1-4ffc-bdf6-1d8e9b55c932",
            "resultFormat": "time_series",
            "query": "ContainerAppSystemLogs_CL\n| where $__timeFilter(TimeGenerated)\n| where EnvironmentName_s == 'incident-env'\n| where isnotempty(ContainerAppName_s)\n| summarize Events=count() by bin(TimeGenerated, $__interval), ContainerAppName_s, Type_s\n| order by TimeGenerated asc"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No events / no data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },

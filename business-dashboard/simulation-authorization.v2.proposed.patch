diff --git a/ingestion-service/app/simulation_auth.py b/ingestion-service/app/simulation_auth.py
new file mode 100644
index 0000000..0191abc
--- /dev/null
+++ b/ingestion-service/app/simulation_auth.py
@@ -0,0 +1,147 @@
+"""Who may call the demo simulator, /api/v1/simulate and its capabilities.
+
+Every simulated incident is persisted and can page real Telegram subscribers,
+so in the deployed service (AUTH_MODE=entra) the simulator is:
+
+  * off (404) unless ENABLE_EVENT_SIMULATOR=true, and then
+  * only for a person -- a delegated Entra user token from an approved
+    dashboard client (SIMULATION_CLIENT_IDS), never an application token --
+  * whose fresh central-access grant (Subscription API /api/v1/access/me,
+    read on every call, never cached) is active and carries
+    Incidents.Simulate for the requested platform tenant.
+
+Producer clients holding Incidents.Write are not simulation operators. Roles
+are not interpreted here: the Subscription API computes `permissions`.
+
+With authentication switched off (local docker-compose; CD refuses that mode
+in production), the simulator stays open exactly as before so the built-in
+demo page at / keeps working, publishing for TENANT-01 unless asked otherwise.
+"""
+import json
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlparse
+from urllib.request import HTTPRedirectHandler, Request, build_opener
+from uuid import UUID
+
+import jwt
+from fastapi import Depends, HTTPException, Query
+from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
+
+bearer = HTTPBearer(auto_error=False)
+LOCAL_TENANT = "TENANT-01"
+
+
+@dataclass(frozen=True)
+class SimulationContext:
+    user_id: str
+    tenant_id: str
+
+
+def denied():
+    return HTTPException(403, "simulation operator permission required")
+
+
+class SimulationVerifier:
+    def __init__(self, directory_id, audience, client_ids, registry, keys=None):
+        UUID(directory_id)
+        if not audience or not client_ids or not callable(registry):
+            raise ValueError("explicit simulation authorization configuration is required")
+        for client in client_ids:
+            UUID(client)
+        self.directory_id, self.audience = directory_id, audience
+        self.client_ids, self.registry = set(client_ids), registry
+        self.keys = keys or jwt.PyJWKClient(
+            f"https://login.microsoftonline.com/{directory_id}/discovery/v2.0/keys", cache_keys=True)
+
+    def verify(self, token, tenant_id=None):
+        try:
+            if not token or len(token) > 65536:
+                raise ValueError("invalid token")
+            signing_key = self.keys.get_signing_key_from_jwt(token)
+            claims = jwt.decode(
+                token, signing_key.key, algorithms=["RS256"],
+                audience=[self.audience, self.audience.removeprefix("api://")],
+                issuer=[f"https://login.microsoftonline.com/{self.directory_id}/v2.0",
+                        f"https://sts.windows.net/{self.directory_id}/"],
+                options={"require": ["exp", "iss", "aud", "tid", "oid"]})
+        except (jwt.PyJWTError, ValueError, TypeError, RecursionError):
+            raise HTTPException(401, "invalid or expired simulation access token") from None
+        scopes = claims.get("scp")
+        client = claims.get("azp") or claims.get("appid")
+        user = claims["oid"]
+        # A service principal with Incidents.Write is not an interactive operator.
+        if (claims["tid"] != self.directory_id or client not in self.client_ids or claims.get("idtyp") == "app"
+                or not isinstance(scopes, str) or "user_impersonation" not in scopes.split() or not isinstance(user, str)):
+            raise denied()
+        try:
+            UUID(user)
+        except ValueError:
+            raise denied() from None
+        # Fresh authoritative grant on every call; never token roles or a cache.
+        grant = self.registry(token)
+        tenants, permissions = grant.get("tenants"), grant.get("permissions")
+        if (grant.get("contract") != "central-access-v1" or grant.get("directory_id") != self.directory_id
+                or grant.get("object_id") != user or grant.get("status") != "active"
+                or not isinstance(permissions, list) or "Incidents.Simulate" not in permissions
+                or not isinstance(tenants, list) or not tenants or not all(isinstance(t, str) for t in tenants)):
+            raise denied()
+        if tenant_id is None:
+            if len(tenants) != 1:
+                raise HTTPException(422, "select an authorized platform tenant")
+            tenant_id = tenants[0]
+        if tenant_id not in tenants:
+            raise HTTPException(403, "platform tenant not authorized")
+        return SimulationContext(user, tenant_id)
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def central_grant(token):
+    origin = os.environ.get("SUBSCRIPTION_API_ORIGIN", "")
+    parsed = urlparse(origin)
+    if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password
+            or parsed.path not in ("", "/") or parsed.query or parsed.fragment):
+        raise HTTPException(503, "central authorization unavailable")
+    request = Request(origin.rstrip("/") + "/api/v1/access/me", headers={"Authorization": "Bearer " + token})
+    try:
+        with build_opener(NoRedirect()).open(request, timeout=10) as response:
+            value = json.loads(response.read(65536))
+            if response.status != 200 or not isinstance(value, dict):
+                raise ValueError("invalid registry response")
+            return value
+    except HTTPError as error:
+        if error.code in (401, 403):
+            raise HTTPException(error.code, "operator access denied") from None
+        raise HTTPException(503, "central authorization unavailable") from None
+    except (URLError, OSError, ValueError):
+        raise HTTPException(503, "central authorization unavailable") from None
+
+
+@lru_cache(maxsize=1)
+def simulation_verifier():
+    return SimulationVerifier(
+        os.environ.get("AUTH_TENANT_ID", ""), os.environ.get("AUTH_AUDIENCE", ""),
+        [value.strip() for value in os.environ.get("SIMULATION_CLIENT_IDS", "").split(",") if value.strip()],
+        central_grant)
+
+
+def require_simulation(tenant_id: str | None = Query(None, max_length=64),
+                       credentials: HTTPAuthorizationCredentials | None = Depends(bearer)):
+    if os.environ.get("AUTH_MODE") != "entra":
+        # Authentication is off for the whole service (local only).
+        return SimulationContext("local-development", tenant_id or LOCAL_TENANT)
+    if os.environ.get("ENABLE_EVENT_SIMULATOR", "").lower() != "true":
+        raise HTTPException(404, "simulation disabled")
+    if credentials is None:
+        raise HTTPException(401, "bearer token required", headers={"WWW-Authenticate": "Bearer"})
+    try:
+        verifier = simulation_verifier()
+    except (ValueError, TypeError):
+        raise HTTPException(503, "simulation authorization unavailable") from None
+    return verifier.verify(credentials.credentials, tenant_id)

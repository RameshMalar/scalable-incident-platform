diff --git a/ingestion-service/tests/test_simulation_authorization.py b/ingestion-service/tests/test_simulation_authorization.py
new file mode 100644
index 0000000..68bb4b4
--- /dev/null
+++ b/ingestion-service/tests/test_simulation_authorization.py
@@ -0,0 +1,130 @@
+"""Simulator authorization. No publisher, Entra or registry network calls."""
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import jwt
+import pytest
+from cryptography.hazmat.primitives.asymmetric import rsa
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+from app.main import app, get_publisher
+from app.simulation_auth import SimulationVerifier
+
+DIRECTORY = "00000000-0000-4000-8000-000000000001"
+CLIENT = "00000000-0000-4000-8000-000000000002"
+USER = "00000000-0000-4000-8000-000000000003"
+
+
+@pytest.fixture
+def security():
+    private = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    keys = Mock(get_signing_key_from_jwt=Mock(return_value=SimpleNamespace(key=private.public_key())))
+    registry = Mock(return_value=dict(contract="central-access-v1", directory_id=DIRECTORY, object_id=USER,
+                                      role="SOC Operator", status="active", tenants=["TENANT-01"],
+                                      permissions=["Dashboard.Read", "Incidents.Simulate", "Subscriptions.SelfManage"]))
+    verifier = SimulationVerifier(DIRECTORY, "api://test-api", [CLIENT], registry, keys)
+
+    def token(**changes):
+        claims = dict(iss=f"https://login.microsoftonline.com/{DIRECTORY}/v2.0", aud="api://test-api",
+                      exp=int(time.time()) + 300, tid=DIRECTORY, oid=USER, azp=CLIENT, scp="user_impersonation")
+        claims.update(changes)
+        return jwt.encode({k: v for k, v in claims.items() if v is not None}, private, algorithm="RS256")
+    return verifier, token
+
+
+@pytest.fixture
+def publisher():
+    fake = SimpleNamespace(publish=AsyncMock())
+    app.dependency_overrides[get_publisher] = lambda: fake
+    yield fake
+    app.dependency_overrides.pop(get_publisher, None)
+
+
+@pytest.mark.parametrize("changes,status", [
+    ({"scp": None}, 403), ({"scp": "Incidents.Write"}, 403), ({"idtyp": "app"}, 403),
+    ({"oid": "unknown"}, 403), ({"azp": "unapproved-client"}, 403), ({"tid": "foreign"}, 403),
+    ({"aud": "wrong-api"}, 401), ({"exp": 1}, 401), ({"iss": "https://evil.example"}, 401),
+])
+def test_denies_invalid_or_unapproved_operator(security, changes, status):
+    verifier, token = security
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(**changes), "TENANT-01")
+    assert error.value.status_code == status
+
+
+@pytest.mark.parametrize("change", [
+    {"permissions": ["Dashboard.Read", "Subscriptions.SelfManage"]},  # SOC Viewer
+    {"permissions": "Incidents.Simulate"}, {"status": "revoked"}, {"status": "disabled"},
+    {"object_id": "another-user"}, {"directory_id": "other"}, {"tenants": []}, {"contract": "old-api"},
+])
+def test_registry_denial_overrides_any_token(security, change):
+    verifier, token = security
+    verifier.registry.return_value.update(change)
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(roles=["Incidents.Simulate"]), "TENANT-01")
+    assert error.value.status_code == 403
+
+
+def test_every_call_rechecks_registry_without_fallback(security):
+    verifier, token = security
+    verifier.verify(token(), "TENANT-01")
+    verifier.registry.side_effect = HTTPException(503, "registry unavailable")
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(), "TENANT-01")
+    assert error.value.status_code == 503 and verifier.registry.call_count == 2
+
+
+def test_operator_cannot_select_another_platform_tenant(security):
+    verifier, token = security
+    assert verifier.verify(token(), "TENANT-01").tenant_id == "TENANT-01"
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(), "TENANT-02")
+    assert error.value.status_code == 403
+
+
+def test_deployed_service_disables_simulation_by_default(monkeypatch, publisher):
+    monkeypatch.setenv("AUTH_MODE", "entra")
+    monkeypatch.delenv("ENABLE_EVENT_SIMULATOR", raising=False)
+    client = TestClient(app)
+    assert client.post("/api/v1/simulate/intrusion").status_code == 404
+    assert client.get("/api/v1/simulation/capabilities").status_code == 404
+    publisher.publish.assert_not_awaited()
+
+
+def test_enabled_simulation_requires_operator_and_binds_tenant(monkeypatch, security, publisher):
+    verifier, token = security
+    monkeypatch.setenv("AUTH_MODE", "entra")
+    monkeypatch.setenv("ENABLE_EVENT_SIMULATOR", "true")
+    monkeypatch.setattr("app.simulation_auth.simulation_verifier", lambda: verifier)
+    client = TestClient(app)
+    assert client.post("/api/v1/simulate/intrusion").status_code == 401
+    headers = {"Authorization": "Bearer " + token()}
+    assert client.post("/api/v1/simulate/intrusion?tenant_id=TENANT-02", headers=headers).status_code == 403
+    publisher.publish.assert_not_awaited()
+    capability = client.get("/api/v1/simulation/capabilities?tenant_id=TENANT-01", headers=headers).json()
+    assert capability["authorization"] == "entra-user-v1" and capability["tenant_id"] == "TENANT-01"
+    assert client.post("/api/v1/simulate/intrusion?tenant_id=TENANT-01", headers=headers).json()["status"] == "accepted"
+    event = publisher.publish.await_args.args[0]
+    assert event.tenant_id == "TENANT-01" and event.event_purpose == "e2e_test"
+
+
+def test_local_auth_off_mode_keeps_the_demo_page_working(monkeypatch, publisher):
+    monkeypatch.delenv("AUTH_MODE", raising=False)
+    monkeypatch.delenv("ENABLE_EVENT_SIMULATOR", raising=False)
+    client = TestClient(app)
+    response = client.post("/api/v1/simulate/crowd")
+    assert response.json()["status"] == "accepted"
+    assert publisher.publish.await_args.args[0].tenant_id == "TENANT-01"
+    # Truthful about having no authorization, so the dashboard refuses it.
+    assert client.get("/api/v1/simulation/capabilities").json()["authorization"] == "local-open"
+
+
+def test_missing_configuration_fails_closed(monkeypatch, publisher):
+    monkeypatch.setenv("AUTH_MODE", "entra")
+    monkeypatch.setenv("ENABLE_EVENT_SIMULATOR", "true")
+    monkeypatch.setattr("app.simulation_auth.simulation_verifier", Mock(side_effect=ValueError("unset")))
+    response = TestClient(app).post("/api/v1/simulate/intrusion", headers={"Authorization": "Bearer x"})
+    assert response.status_code == 503
+    publisher.publish.assert_not_awaited()

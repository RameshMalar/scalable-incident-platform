+"""Proposed tests; no publisher or Entra network operations are performed."""
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock, AsyncMock
+
+import jwt
+import pytest
+from cryptography.hazmat.primitives.asymmetric import rsa
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+from app.main import app, get_publisher
+from app.simulation_auth import SimulationVerifier, simulation_verifier
+
+DIRECTORY='00000000-0000-0000-0000-000000000001'
+CLIENT='00000000-0000-0000-0000-000000000002'
+USER='00000000-0000-0000-0000-000000000003'
+
+
+@pytest.fixture
+def security():
+    private = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    keys=Mock(get_signing_key_from_jwt=Mock(return_value=SimpleNamespace(key=private.public_key())))
+    registry=Mock(return_value=dict(contract='central-access-v1',directory_id=DIRECTORY,object_id=USER,
+        role='SOC Operator',status='active',tenants=['TENANT-01']))
+    verifier=SimulationVerifier(DIRECTORY,'api://test-api',[CLIENT],registry,keys)
+    def token(**changes):
+        claims=dict(iss=f'https://login.microsoftonline.com/{DIRECTORY}/v2.0',aud='api://test-api',exp=int(time.time())+300,
+                    tid=DIRECTORY,oid=USER,azp=CLIENT,scp='user_impersonation',roles=['Incidents.Simulate'])
+        claims.update(changes)
+        return jwt.encode(claims,private,algorithm='RS256')
+    return verifier,token
+
+
+@pytest.mark.parametrize('changes,status',[
+    ({'scp':''},403),({'idtyp':'app'},403),
+    ({'oid':'unknown'},403),({'azp':'unapproved-client'},403),({'tid':'foreign'},403),
+    ({'aud':'wrong-api'},401),({'exp':1},401),({'iss':'https://evil.example'},401),
+])
+def test_denies_invalid_or_unapproved_operator(security,changes,status):
+    verifier,token=security
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(**changes),'TENANT-01')
+    assert error.value.status_code==status
+
+
+@pytest.mark.parametrize('change',[{'role':'SOC Viewer'},{'status':'revoked'},{'status':'disabled'},
+    {'object_id':'another-user'},{'tenants':['TENANT-DEV']},{'contract':'old-api'}])
+def test_registry_denial_overrides_stale_signed_roles(security,change):
+    verifier,token=security
+    verifier.registry.return_value.update(change)
+    with pytest.raises(HTTPException) as error:verifier.verify(token(),'TENANT-01')
+    assert error.value.status_code==403
+
+
+def test_each_post_rechecks_registry_without_fallback(security):
+    verifier,token=security
+    verifier.verify(token(),'TENANT-01')
+    verifier.registry.side_effect=HTTPException(503,'registry unavailable')
+    with pytest.raises(HTTPException) as error:verifier.verify(token(),'TENANT-01')
+    assert error.value.status_code==503 and verifier.registry.call_count==2
+
+
+def test_no_per_user_entra_role_is_needed_when_registry_explicitly_approves(security):
+    verifier,token=security
+    assert verifier.verify(token(roles=[]),'TENANT-01').user_id==USER
+
+
+def test_authorized_user_cannot_select_another_platform_tenant(security):
+    verifier,token=security
+    assert verifier.verify(token(),'TENANT-01').user_id==USER
+    with pytest.raises(HTTPException) as error:
+        verifier.verify(token(),'TENANT-02')
+    assert error.value.status_code==403
+
+
+def test_both_routes_disabled_by_default(monkeypatch):
+    monkeypatch.delenv('ENABLE_EVENT_SIMULATOR',raising=False)
+    publisher=SimpleNamespace(publish=AsyncMock())
+    app.dependency_overrides[get_publisher]=lambda:publisher
+    try:
+        client=TestClient(app)
+        assert client.post('/api/v1/simulate/intrusion').status_code==404
+        assert client.get('/api/v1/simulation/capabilities').status_code==404
+        publisher.publish.assert_not_awaited()
+    finally:
+        app.dependency_overrides.pop(get_publisher,None)
+
+
+def test_routes_require_token_and_bind_published_tenant(monkeypatch,security):
+    verifier,token=security
+    monkeypatch.setenv('ENABLE_EVENT_SIMULATOR','true')
+    monkeypatch.setenv('AUTH_MODE','entra')
+    monkeypatch.setattr('app.simulation_auth.simulation_verifier',lambda:verifier)
+    publisher=SimpleNamespace(publish=AsyncMock())
+    app.dependency_overrides[get_publisher]=lambda:publisher
+    try:
+        client=TestClient(app)
+        assert client.post('/api/v1/simulate/intrusion').status_code==401
+        headers={'Authorization':'Bearer '+token()}
+        assert client.post('/api/v1/simulate/intrusion?tenant_id=TENANT-02',headers=headers).status_code==403
+        publisher.publish.assert_not_awaited()
+        metadata=client.get('/api/v1/simulation/capabilities?tenant_id=TENANT-01',headers=headers)
+        assert metadata.json()['authorization']=='entra-user-v1'
+        response=client.post('/api/v1/simulate/intrusion?tenant_id=TENANT-01',headers=headers)
+        assert response.json()['status']=='accepted'
+        publisher.publish.assert_awaited_once()
+        event=publisher.publish.await_args.args[0]
+        assert event.tenant_id=='TENANT-01' and event.event_purpose=='e2e_test'
+    finally:
+        app.dependency_overrides.pop(get_publisher,None)

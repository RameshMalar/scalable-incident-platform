+"""PROPOSED: explicit delegated-user authorization for demo endpoints only."""
+from dataclasses import dataclass
+from functools import lru_cache
+import os
+import json
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlparse
+from urllib.request import Request, build_opener, HTTPRedirectHandler
+from uuid import UUID
+
+from fastapi import Depends, HTTPException
+from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
+import jwt
+
+bearer = HTTPBearer(auto_error=False)
+
+
+@dataclass(frozen=True)
+class SimulationContext:
+    user_id: str
+    tenant_id: str
+
+
+class SimulationVerifier:
+    def __init__(self, directory_id, audience, client_ids, registry, keys=None):
+        UUID(directory_id)
+        if not audience or not client_ids or not callable(registry):
+            raise ValueError('Explicit simulation authorization configuration is required')
+        for client in client_ids:
+            UUID(client)
+        self.directory_id, self.audience = directory_id, audience
+        self.client_ids, self.registry = set(client_ids), registry
+        self.keys = keys or jwt.PyJWKClient(f'https://login.microsoftonline.com/{directory_id}/discovery/v2.0/keys', cache_keys=True)
+
+    def verify(self, token, tenant_id=None):
+        try:
+            if not token or len(token) > 65536:
+                raise ValueError('invalid token')
+            signing_key = self.keys.get_signing_key_from_jwt(token)
+            audiences = [self.audience, self.audience.removeprefix('api://')]
+            claims = jwt.decode(token, signing_key.key, algorithms=['RS256'], audience=audiences,
+                issuer=[f'https://login.microsoftonline.com/{self.directory_id}/v2.0', f'https://sts.windows.net/{self.directory_id}/'],
+                options={'require': ['exp', 'iss', 'aud', 'tid', 'oid']})
+        except (jwt.PyJWTError, ValueError, TypeError, RecursionError):
+            raise HTTPException(401, 'invalid or expired simulation access token') from None
+        roles, scopes = claims.get('roles', []), claims.get('scp', '')
+        if not isinstance(roles, list) or not isinstance(scopes, str) or any(not isinstance(role, str) for role in roles):
+            raise HTTPException(403, 'simulation operator permission required')
+        client = claims.get('azp') or claims.get('appid')
+        user = claims['oid']
+        # A service principal with Incidents.Write is not an interactive operator.
+        if (claims['tid'] != self.directory_id or client not in self.client_ids
+                or claims.get('idtyp') == 'app' or 'user_impersonation' not in scopes.split()
+                or not isinstance(user, str)):
+            raise HTTPException(403, 'simulation operator permission required')
+        try:UUID(user)
+        except ValueError:raise HTTPException(403,'simulation operator permission required') from None
+        # Fresh authoritative registry for every POST and capability check.
+        # Never fall back to token roles, an ingestion user map or cached grants.
+        grant=self.registry(token)
+        if (grant.get('contract')!='central-access-v1' or grant.get('directory_id')!=self.directory_id
+                or grant.get('object_id')!=user or grant.get('status')!='active'
+                or grant.get('role') not in ('Platform Admin','SOC Operator')):
+            raise HTTPException(403,'simulation operator permission required')
+        allowed=grant.get('tenants')
+        if (not isinstance(allowed,list) or not allowed or not set(allowed).issubset({'TENANT-01','TENANT-02','TENANT-03'})):
+            raise HTTPException(403,'platform tenant not authorized')
+        if tenant_id is None:
+            if len(allowed) != 1:
+                raise HTTPException(422, 'select an authorized platform tenant')
+            tenant_id = allowed[0]
+        if tenant_id not in allowed:
+            raise HTTPException(403, 'platform tenant not authorized')
+        return SimulationContext(user, tenant_id)
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self,req,fp,code,msg,headers,newurl):return None
+
+
+def central_grant(token):
+    origin=os.environ.get('SUBSCRIPTION_API_ORIGIN','')
+    parsed=urlparse(origin)
+    if (parsed.scheme!='https' or not parsed.hostname or parsed.username or parsed.password
+            or parsed.path not in ('','/') or parsed.query or parsed.fragment):
+        raise HTTPException(503,'central authorization unavailable')
+    request=Request(origin.rstrip('/')+'/api/v1/access/me',headers={'Authorization':'Bearer '+token})
+    try:
+        with build_opener(NoRedirect()).open(request,timeout=10) as response:
+            value=json.loads(response.read(65536))
+            if response.status!=200 or not isinstance(value,dict):raise ValueError('invalid registry response')
+            return value
+    except HTTPError as error:
+        if error.code in (401,403):raise HTTPException(error.code,'operator access denied') from None
+        raise HTTPException(503,'central authorization unavailable') from None
+    except (URLError,OSError,ValueError):raise HTTPException(503,'central authorization unavailable') from None
+
+
+@lru_cache(maxsize=1)
+def simulation_verifier():
+    return SimulationVerifier(os.environ.get('AUTH_TENANT_ID', ''), os.environ.get('AUTH_AUDIENCE', ''),
+        [value.strip() for value in os.environ.get('SIMULATION_CLIENT_IDS', '').split(',') if value.strip()],
+        central_grant)
+
+
+def require_simulation(tenant_id: str | None = None, credentials: HTTPAuthorizationCredentials | None = Depends(bearer)):
+    if os.environ.get('ENABLE_EVENT_SIMULATOR', '').lower() != 'true' or os.environ.get('AUTH_MODE') != 'entra':
+        raise HTTPException(404, 'simulation disabled')
+    if credentials is None:
+        raise HTTPException(401, 'bearer token required', headers={'WWW-Authenticate': 'Bearer'})
+    try:
+        verifier = simulation_verifier()
+    except (ValueError, TypeError):
+        raise HTTPException(503, 'simulation authorization unavailable') from None
+    return verifier.verify(credentials.credentials, tenant_id)
